---
import "../styles/global.css";
import BlurFade from "@/components/magicui/blur-fade";
import OpencodeName from "@/components/OpencodeName.astro";

const github = "https://github.com/moKshagna-p";
const twitter = "https://x.com/mokshagna_03";
const linkedin = "https://www.linkedin.com/in/mokshagnareddy/";
const discord = "https://discord.com/users/725911458554183680";
const email = "mailto:mokshagnareddy45@gmail.com";

const BLUR_FADE_DELAY = 0.04;

// Hardcoded repos to avoid GitHub API rate limits
const repos = [
    {
        name: "musico",
        html_url: "https://github.com/moKshagna-p/musico",
        description: "building letterboxd for music",
    },
    {
        name: "letterboxd-CLI",
        html_url: "https://github.com/moKshagna-p/letterboxd-CLI",
        description: "A letterboxd-cli",
    },
    {
        name: "f1-cli",
        html_url: "https://github.com/moKshagna-p/f1-cli",
        description: "F1 in your terminal",
    },
    {
        name: "lrc",
        html_url: "https://github.com/moKshagna-p/lrc",
        description:
            "Full-screen terminal UI for synced Apple Music lyrics with album art",
    },
    {
        name: "sailor",
        html_url: "https://github.com/moKshagna-p/sailor",
        description: "honest AI resume tailoring, without invented claims.",
    },
    {
        name: "musicbar",
        html_url: "https://github.com/moKshagna-p/musicbar-macos",
        description: "native macOS now-playing bar with glass UI and controls",
    },
    {
        name: "cinder",
        html_url: "https://github.com/moKshagna-p/cinder",
        description: "music visualization from your terminal",
    },
    {
        name: "LeetBar",
        html_url: "https://github.com/moKshagna-p/LeetBar",
        description:
            "macOS menu bar app for tracking LeetCode solved counts and streaks at a glance",
    },
];
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <title>Mokshagna Reddy</title>
        <link rel="icon" type="image/png" href="/favicon.png" />
        <meta
            name="description"
            content="Mokshagna Reddy — minimal portfolio."
        />
        <meta name="author" content="Mokshagna Reddy" />
        <meta name="theme-color" content="#000000" />
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link
            href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;700&display=swap"
            rel="stylesheet"
        />
        <style>
            .font-mono-stack {
                font-family:
                    "Berkeley Mono", "IBM Plex Mono", ui-monospace,
                    SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono",
                    "Courier New", monospace;
            }
        </style>
    </head>
    <body
        class="relative flex min-h-[100dvh] w-full flex-col bg-background text-foreground font-mono-stack antialiased selection:bg-white/20"
    >
        <main
            class="relative z-10 w-full max-w-4xl mx-auto px-6 py-10 md:py-12 flex flex-1 flex-col"
        >
            <header class="mb-8 md:mb-10">
                <BlurFade delay={BLUR_FADE_DELAY} client:load>
                    <div class="mb-6">
                        <OpencodeName />
                    </div>
                </BlurFade>

                <BlurFade delay={BLUR_FADE_DELAY * 2} client:load>
                    <p
                        class="text-muted-foreground text-sm leading-relaxed max-w-xl opacity-80"
                    >
                        web dev & cli/tui builder.
                    </p>
                </BlurFade>
            </header>

            <section class="mb-2 md:mb-4 pt-2">
                <BlurFade delay={BLUR_FADE_DELAY * 3} client:load>
                    <div class="mb-6">
                        <h2
                            class="text-xs font-medium text-foreground opacity-90"
                        >
                            Projects
                        </h2>
                    </div>
                </BlurFade>

                <div class="flex flex-col gap-2">
                    {
                        repos.map((repo, i) => (
                            <div class={i >= 6 ? "hidden extra-project" : ""}>
                                <BlurFade
                                    delay={BLUR_FADE_DELAY * 4 + i * 0.1}
                                    client:load
                                >
                                    <div class="group flex items-baseline gap-3 -mx-4 py-2 px-4 rounded-md hover:bg-white/[0.04] transition-colors">
                                        <span class="text-muted-foreground/40 shrink-0">
                                            [*]
                                        </span>
                                        <a
                                            href={repo.html_url}
                                            target="_blank"
                                            rel="noopener noreferrer"
                                            class="flex flex-col sm:flex-row sm:items-baseline justify-between w-full gap-y-1 sm:gap-x-3 min-w-0"
                                        >
                                            <strong class="font-medium text-foreground/90 group-hover:text-white transition-colors shrink-0">
                                                {repo.name}
                                            </strong>
                                            <span class="text-muted-foreground/70 text-sm sm:text-base sm:text-right">
                                                {repo.description || ""}
                                            </span>
                                        </a>
                                    </div>
                                </BlurFade>
                            </div>
                        ))
                    }
                </div>
                {
                    repos.length > 6 && (
                        <BlurFade delay={BLUR_FADE_DELAY * 4 + 0.4} client:load>
                            <button
                                id="show-more-projects"
                                class="text-muted-foreground/70 hover:text-foreground text-[15px] mt-2 transition-colors"
                            >
                                + show more
                            </button>
                        </BlurFade>
                    )
                }
            </section>

            <section
                id="github-figures"
                class="github-figures"
                aria-label="Live GitHub figures"
            >
                <a
                    class="github-figure"
                    href={github}
                    target="_blank"
                    rel="noopener noreferrer"
                    aria-label="View GitHub stars"
                >
                    <div class="github-stars-graphic" aria-hidden="true">
                        <svg
                            id="github-stars-chart"
                            viewBox="0 0 520 510"
                            preserveAspectRatio="none"
                        >
                            <defs>
                                <pattern
                                    id="star-stripes"
                                    width="13"
                                    height="13"
                                    patternUnits="userSpaceOnUse"
                                    patternTransform="rotate(45)"
                                >
                                    <line
                                        x1="0"
                                        y1="0"
                                        x2="0"
                                        y2="13"
                                        stroke="currentColor"
                                        stroke-width="2"
                                    />
                                </pattern>
                                <linearGradient id="star-fade" x1="0" y1="0" x2="0" y2="1">
                                    <stop offset="0" stop-color="#8d888a" stop-opacity="0.58" />
                                    <stop offset="1" stop-color="#8d888a" stop-opacity="0" />
                                </linearGradient>
                            </defs>
                            <path
                                id="github-stars-area"
                                d="M 16 490 L 85 468 L 130 442 L 168 384 L 203 348 L 240 278 L 286 234 L 335 168 L 389 121 L 444 43 L 444 490 Z"
                                fill="url(#star-stripes)"
                                opacity="0.42"
                            ></path>
                            <path
                                id="github-stars-gradient"
                                d="M 16 490 L 85 468 L 130 442 L 168 384 L 203 348 L 240 278 L 286 234 L 335 168 L 389 121 L 444 43 L 444 490 Z"
                                fill="url(#star-fade)"
                            ></path>
                            <path
                                id="github-stars-line"
                                d="M 16 490 L 85 468 L 130 442 L 168 384 L 203 348 L 240 278 L 286 234 L 335 168 L 389 121 L 444 43"
                                fill="none"
                                stroke="currentColor"
                                stroke-width="2"
                                vector-effect="non-scaling-stroke"
                            ></path>
                        </svg>
                    </div>
                    <p class="github-figure-caption">
                        <span>Fig 1.</span>
                        <strong id="github-stars" aria-live="polite">—</strong>
                        <span>GitHub Stars</span>
                    </p>
                </a>

                <a
                    class="github-figure"
                    href={github}
                    target="_blank"
                    rel="noopener noreferrer"
                    aria-label="View GitHub contribution activity"
                >
                    <div
                        id="github-contributions"
                        class="github-contribution-grid"
                        aria-hidden="true"
                    ></div>
                    <p class="github-figure-caption">
                        <span>Fig 2.</span>
                        <strong id="github-contribution-total" aria-live="polite">—</strong>
                        <span>Contributions</span>
                    </p>
                </a>
            </section>

            <BlurFade
                delay={BLUR_FADE_DELAY * 5}
                client:load
                className="mt-auto pb-6"
            >
                <footer
                    class="flex flex-col sm:flex-row justify-between items-center sm:items-start text-xs border-t border-white/10 pt-8 opacity-80 gap-6 sm:gap-0"
                >
                    <div class="flex items-center gap-4 text-muted-foreground">
                        <a
                            href={github}
                            target="_blank"
                            rel="me noopener noreferrer"
                            aria-label="GitHub"
                            title="GitHub"
                            class="hover:text-foreground transition-colors focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-foreground rounded-sm"
                        >
                            <svg
                                viewBox="0 0 24 24"
                                aria-hidden="true"
                                class="size-4 fill-current"
                                ><path
                                    d="M12 2C6.477 2 2 6.586 2 12.253c0 4.531 2.865 8.374 6.839 9.73.5.096.683-.22.683-.489 0-.24-.008-1.04-.012-1.885-2.782.619-3.369-1.22-3.369-1.22-.455-1.185-1.11-1.5-1.11-1.5-.908-.641.068-.628.068-.628 1.004.072 1.532 1.056 1.532 1.056.892 1.568 2.341 1.115 2.91.852.091-.665.349-1.115.635-1.371-2.22-.26-4.555-1.14-4.555-5.071 0-1.12.39-2.034 1.03-2.751-.104-.261-.446-1.31.098-2.731 0 0 .84-.277 2.75 1.05A9.31 9.31 0 0 1 12 6.89a9.28 9.28 0 0 1 2.504.35c1.909-1.327 2.748-1.05 2.748-1.05.546 1.422.203 2.47.1 2.731.64.717 1.028 1.63 1.028 2.75 0 3.941-2.34 4.808-4.566 5.063.359.32.678.945.678 1.904 0 1.375-.012 2.482-.012 2.82 0 .272.18.59.688.488C19.14 20.624 22 16.783 22 12.253 22 6.586 17.523 2 12 2Z"
                                ></path></svg
                            >
                            <span class="sr-only">GitHub</span>
                        </a>
                        <a
                            href={twitter}
                            target="_blank"
                            rel="me noopener noreferrer"
                            aria-label="Twitter / X"
                            title="Twitter / X"
                            class="hover:text-foreground transition-colors focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-foreground rounded-sm"
                        >
                            <svg
                                viewBox="0 0 24 24"
                                aria-hidden="true"
                                class="size-4 fill-current"
                                ><path
                                    d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H9.66l4.713 6.231 3.871-4.429Zm-1.161 17.52h1.833L8.665 4.126H6.698L17.083 19.77Z"
                                ></path></svg
                            >
                            <span class="sr-only">Twitter / X</span>
                        </a>
                        <a
                            href={linkedin}
                            target="_blank"
                            rel="me noopener noreferrer"
                            aria-label="LinkedIn"
                            title="LinkedIn"
                            class="hover:text-foreground transition-colors focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-foreground rounded-sm"
                        >
                            <svg
                                viewBox="0 0 24 24"
                                aria-hidden="true"
                                class="size-4 fill-current"
                                ><path
                                    d="M20.45 20.45h-3.24v-5.57c0-1.33-.03-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.99V10.03h3.11v1.42h.04c.43-.82 1.49-1.68 3.07-1.68 3.29 0 3.89 2.16 3.89 4.98v5.7ZM6.34 8.61a1.88 1.88 0 1 1 0-3.76 1.88 1.88 0 0 1 0 3.76ZM7.96 20.45H4.72V10.03h3.24v10.42ZM22.08 2H1.92C.86 2 0 2.84 0 3.88v16.24C0 21.16.86 22 1.92 22h20.16c1.06 0 1.92-.84 1.92-1.88V3.88C24 2.84 23.14 2 22.08 2Z"
                                ></path></svg
                            >
                            <span class="sr-only">LinkedIn</span>
                        </a>
                        <a
                            href={discord}
                            target="_blank"
                            rel="me noopener noreferrer"
                            aria-label="Discord"
                            title="Discord"
                            class="hover:text-foreground transition-colors focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-foreground rounded-sm"
                        >
                            <svg
                                viewBox="0 0 24 24"
                                aria-hidden="true"
                                class="size-4 fill-current"
                                ><path
                                    d="M20.32 4.37A19.8 19.8 0 0 0 15.43 3c-.21.38-.45.9-.61 1.3a18.27 18.27 0 0 0-5.64 0A12.7 12.7 0 0 0 8.56 3a19.74 19.74 0 0 0-4.89 1.38C.58 9.03-.26 13.57.16 18.05a19.9 19.9 0 0 0 6 3.03c.49-.67.93-1.38 1.31-2.13a12.84 12.84 0 0 1-2.06-.99c.17-.13.34-.27.5-.41 3.97 1.85 8.28 1.85 12.2 0 .17.14.33.28.5.41-.66.39-1.35.72-2.06.99.38.75.82 1.46 1.31 2.13a19.85 19.85 0 0 0 6-3.03c.5-5.2-.85-9.7-3.54-13.68ZM8.02 15.34c-1.16 0-2.11-1.06-2.11-2.37 0-1.3.93-2.37 2.11-2.37 1.18 0 2.13 1.07 2.11 2.37 0 1.31-.93 2.37-2.11 2.37Zm7.96 0c-1.16 0-2.11-1.06-2.11-2.37 0-1.3.93-2.37 2.11-2.37 1.18 0 2.13 1.07 2.11 2.37 0 1.31-.93 2.37-2.11 2.37Z"
                                ></path></svg
                            >
                            <span class="sr-only">Discord</span>
                        </a>
                        <a
                            href={email}
                            aria-label="Email"
                            title="Email"
                            class="hover:text-foreground transition-colors focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-foreground rounded-sm"
                        >
                            <svg
                                viewBox="0 0 24 24"
                                aria-hidden="true"
                                class="size-4 fill-none stroke-current stroke-[1.8]"
                                ><rect x="3" y="5" width="18" height="14" rx="2"
                                ></rect><path d="m3 7 9 6 9-6"></path></svg
                            >
                            <span class="sr-only">Email</span>
                        </a>
                    </div>
                    <button
                        id="theme-toggle"
                        class="text-muted-foreground hover:text-foreground transition-colors"
                    >
                        <span id="theme-name">midnight</span>
                    </button>
                </footer>
            </BlurFade>
        </main>

        <script>
            const themes = ["midnight", "graphite"];
            let currentThemeIndex = 0;

            const themeToggle = document.getElementById("theme-toggle");
            const themeName = document.getElementById("theme-name");

            if (themeToggle && themeName) {
                themeToggle.addEventListener("click", () => {
                    currentThemeIndex = (currentThemeIndex + 1) % themes.length;
                    const newTheme = themes[currentThemeIndex];
                    document.documentElement.dataset.theme = newTheme;
                    themeName.innerText = newTheme;
                });
            }

            const showMoreBtn = document.getElementById("show-more-projects");
            if (showMoreBtn) {
                let isExpanded = false;
                showMoreBtn.addEventListener("click", () => {
                    isExpanded = !isExpanded;
                    document
                        .querySelectorAll(".extra-project")
                        .forEach((el) => {
                            if (isExpanded) {
                                el.classList.remove("hidden");
                            } else {
                                el.classList.add("hidden");
                            }
                        });
                    showMoreBtn.innerText = isExpanded
                        ? "- show less"
                        : "+ show more";
                });
            }

            const githubUser = "moKshagna-p";
            const githubStars = document.getElementById("github-stars");
            const githubContributionTotal = document.getElementById(
                "github-contribution-total",
            );
            const githubContributionGrid = document.getElementById(
                "github-contributions",
            );
            const formatCount = (value: number) =>
                new Intl.NumberFormat("en", {
                    notation: "compact",
                    maximumFractionDigits: 1,
                }).format(value);

            const renderContributions = (
                contributions: Array<{ date: string; count: number; level?: number }>,
            ) => {
                if (!githubContributionGrid) return;

                const activity = new Map(
                    contributions.map((contribution) => [
                        contribution.date,
                        contribution,
                    ]),
                );
                const today = new Date();
                const start = new Date(today);
                start.setDate(today.getDate() - 379);
                const cells = Array.from({ length: 380 }, (_, index) => {
                    const date = new Date(start);
                    date.setDate(start.getDate() + index);
                    const key = date.toISOString().slice(0, 10);
                    const contribution = activity.get(key);
                    const level = Math.min(4, contribution?.level ?? (contribution?.count ? 1 : 0));
                    return `<i class="github-contribution-cell" data-level="${level}"></i>`;
                });

                githubContributionGrid.innerHTML = cells.join("");
            };

            const loadGithubFigures = async () => {
                try {
                    const [repositoriesResponse, contributionsResponse] =
                        await Promise.all([
                            fetch(
                                `https://api.github.com/users/${githubUser}/repos?per_page=100&type=owner`,
                            ),
                            fetch(
                                `https://github-contributions-api.jogruber.de/v4/${githubUser}?y=last`,
                            ),
                        ]);

                    if (!repositoriesResponse.ok || !contributionsResponse.ok) {
                        throw new Error("GitHub figures are unavailable");
                    }

                    const repositories = await repositoriesResponse.json();
                    const contributionData = await contributionsResponse.json();
                    const contributions = contributionData.contributions || [];
                    const stars = repositories.reduce(
                        (total: number, repository: { stargazers_count: number }) =>
                            total + repository.stargazers_count,
                        0,
                    );
                    const contributionTotal = contributions.reduce(
                        (total: number, contribution: { count: number }) =>
                            total + contribution.count,
                        0,
                    );

                    if (githubStars) githubStars.textContent = formatCount(stars);
                    if (githubContributionTotal) {
                        githubContributionTotal.textContent = formatCount(contributionTotal);
                    }
                    renderContributions(contributions);
                } catch {
                    if (githubStars) githubStars.textContent = "—";
                    if (githubContributionTotal) githubContributionTotal.textContent = "—";
                }
            };

            loadGithubFigures();
        </script>
    </body>
</html>
