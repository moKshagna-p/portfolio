---
import "../styles/global.css";
import RetroGrid from "@/components/magicui/retro-grid";
import BlurFade from "@/components/magicui/blur-fade";
import WordPullUp from "@/components/magicui/word-pull-up";

const github = "https://github.com/moKshagna-p";
const email = "mailto:mokshagnareddy45@gmail.com";

const BLUR_FADE_DELAY = 0.04;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Mokshagna Reddy — Portfolio</title>
    <meta
      name="description"
      content="Mokshagna Reddy — a single-screen portfolio built with Bun and Astro."
    />
    <meta name="author" content="Mokshagna Reddy" />
    <meta name="theme-color" content="#000000" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Oooh+Baby&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="relative flex min-h-screen w-full flex-col justify-between overflow-hidden bg-background font-sans text-foreground">
    <RetroGrid client:load />

    <main class="page relative z-10 w-full max-w-6xl mx-auto px-6 py-12 md:py-40 flex flex-col justify-between min-h-screen">
      <header class="hero max-w-2xl" aria-labelledby="name">
        <BlurFade delay={BLUR_FADE_DELAY} client:load>
          <WordPullUp
            words="Mokshagna Reddy"
            className="text-left font-['Oooh_Baby'] text-6xl md:text-8xl tracking-tight mb-6"
            client:load
          />
        </BlurFade>

        <BlurFade delay={BLUR_FADE_DELAY * 2} client:load>
          <p class="lede text-muted-foreground text-lg mb-6 leading-relaxed">
            i’m a software engineer focused on thoughtful interfaces, clean
            product systems, and frontend work that feels effortless. i like
            building things that stay simple even when the problem is not.
          </p>
        </BlurFade>
        
        <BlurFade delay={BLUR_FADE_DELAY * 3} client:load>
          <p class="lede text-muted-foreground text-lg leading-relaxed">
            before focusing on product interfaces, i spent time shipping across
            web and mobile. i care about making complex systems accessible, fast,
            and quiet in the best possible way.
          </p>
        </BlurFade>
      </header>

      <BlurFade delay={BLUR_FADE_DELAY * 4} client:load className="mt-auto pt-12">
        <div class="footer-bottom flex justify-between items-center w-full">
          <button id="theme-toggle" class="theme-toggle flex items-center gap-2 text-muted-foreground hover:text-foreground transition-colors">
            <span class="theme-label italic">theme:</span>
            <span id="theme-name" class="font-medium">midnight</span>
          </button>
          <div class="meta-links flex gap-6 text-muted-foreground" aria-label="External contact links">
            <a href={github} target="_blank" rel="me noopener noreferrer" class="hover:text-foreground transition-colors">
              github
            </a>
            <a href={email} class="hover:text-foreground transition-colors">email</a>
          </div>
        </div>
      </BlurFade>
    </main>

    <script>
      // Theme Cycler
      const themes = ["midnight", "parchment", "graphite"];
      let currentThemeIndex = 0;

      const themeToggle = document.getElementById("theme-toggle");
      const themeName = document.getElementById("theme-name");

      if (themeToggle && themeName) {
        themeToggle.addEventListener("click", () => {
          currentThemeIndex = (currentThemeIndex + 1) % themes.length;
          const newTheme = themes[currentThemeIndex];

          document.documentElement.dataset.theme = newTheme;

          themeName.style.opacity = "0";
          themeName.style.transform = "translateY(4px)";

          setTimeout(() => {
            themeName.innerText = newTheme;
            themeName.style.opacity = "1";
            themeName.style.transform = "translateY(0)";
          }, 200);
        });
      }
    </script>
  </body>
</html>
