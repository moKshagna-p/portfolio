---
import "../styles/global.css";
import RetroGrid from "@/components/magicui/retro-grid";
import BlurFade from "@/components/magicui/blur-fade";
import WordPullUp from "@/components/magicui/word-pull-up";

const github = "https://github.com/moKshagna-p";
const email = "mailto:mokshagnareddy45@gmail.com";

const BLUR_FADE_DELAY = 0.04;

// Fetch repositories (fallback to empty array if fails during build)
let repos = [];
try {
  const res = await fetch("https://api.github.com/users/moKshagna-p/repos?sort=updated&per_page=6");
  if (res.ok) {
    repos = await res.json();
  }
} catch (e) {
  console.error("Failed to fetch repos", e);
}
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Mokshagna Reddy</title>
    <meta
      name="description"
      content="Mokshagna Reddy — minimal portfolio."
    />
    <meta name="author" content="Mokshagna Reddy" />
    <meta name="theme-color" content="#000000" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="relative flex min-h-screen w-full flex-col overflow-hidden bg-background font-sans text-foreground">
    <RetroGrid client:load />

    <main class="relative z-10 w-full max-w-3xl mx-auto px-6 py-20 flex flex-col min-h-screen">
      <header class="mb-16">
        <BlurFade delay={BLUR_FADE_DELAY} client:load>
          <WordPullUp
            words="Mokshagna Reddy"
            className="text-left font-['Inter'] font-medium text-2xl md:text-3xl tracking-tight mb-6"
            client:load
          />
        </BlurFade>

        <BlurFade delay={BLUR_FADE_DELAY * 2} client:load>
          <p class="text-muted-foreground text-sm md:text-base leading-relaxed max-w-xl">
            software engineer focused on clean interfaces and simple product systems.
          </p>
        </BlurFade>
      </header>

      <section class="flex-1 mb-16">
        <BlurFade delay={BLUR_FADE_DELAY * 3} client:load>
          <h2 class="text-sm font-medium text-muted-foreground mb-6 uppercase tracking-wider">Projects</h2>
        </BlurFade>
        
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          {repos.map((repo, i) => (
            <BlurFade delay={BLUR_FADE_DELAY * 4 + i * 0.05} client:load>
              <a 
                href={repo.html_url} 
                target="_blank" 
                rel="noopener noreferrer"
                class="block p-4 rounded-xl border border-white/10 bg-white/5 hover:bg-white/10 transition-colors"
              >
                <div class="flex justify-between items-start mb-2">
                  <h3 class="font-medium text-sm text-foreground">{repo.name}</h3>
                  {repo.stargazers_count > 0 && (
                    <span class="text-xs text-muted-foreground flex items-center gap-1">
                      <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z"></path></svg>
                      {repo.stargazers_count}
                    </span>
                  )}
                </div>
                <p class="text-xs text-muted-foreground line-clamp-2">
                  {repo.description || "No description provided."}
                </p>
              </a>
            </BlurFade>
          ))}
        </div>
      </section>

      <BlurFade delay={BLUR_FADE_DELAY * 5} client:load className="mt-auto">
        <footer class="flex justify-between items-center text-sm">
          <div class="flex gap-4 text-muted-foreground">
            <a href={github} target="_blank" rel="me noopener noreferrer" class="hover:text-foreground transition-colors">github</a>
            <a href={email} class="hover:text-foreground transition-colors">email</a>
          </div>
          <button id="theme-toggle" class="text-muted-foreground hover:text-foreground transition-colors">
            <span id="theme-name">midnight</span>
          </button>
        </footer>
      </BlurFade>
    </main>

    <script>
      const themes = ["midnight", "parchment", "graphite"];
      let currentThemeIndex = 0;

      const themeToggle = document.getElementById("theme-toggle");
      const themeName = document.getElementById("theme-name");

      if (themeToggle && themeName) {
        themeToggle.addEventListener("click", () => {
          currentThemeIndex = (currentThemeIndex + 1) % themes.length;
          const newTheme = themes[currentThemeIndex];
          document.documentElement.dataset.theme = newTheme;
          themeName.innerText = newTheme;
        });
      }
    </script>
  </body>
</html>
