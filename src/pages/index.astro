---
import "../styles/global.css";
import BlurFade from "@/components/magicui/blur-fade";
import OpencodeName from "@/components/OpencodeName.astro";

const github = "https://github.com/moKshagna-p";
const email = "mailto:mokshagnareddy45@gmail.com";

const BLUR_FADE_DELAY = 0.04;

// Hardcoded repos to avoid GitHub API rate limits
const repos = [
    { name: "musico", html_url: "https://github.com/moKshagna-p/musico", description: "building letterboxd for music" },
    { name: "letterboxd-CLI", html_url: "https://github.com/moKshagna-p/letterboxd-CLI", description: "A letterboxd-cli" },
    { name: "f1-cli", html_url: "https://github.com/moKshagna-p/f1-cli", description: "F1 in your terminal" },
    { name: "lrc", html_url: "https://github.com/moKshagna-p/lrc", description: "Full-screen terminal UI for synced Apple Music lyrics with album art" },
    { name: "cinder", html_url: "https://github.com/moKshagna-p/cinder", description: "music visualization from your terminal" },
    { name: "LeetBar", html_url: "https://github.com/moKshagna-p/LeetBar", description: "macOS menu bar app for tracking LeetCode solved counts and streaks at a glance" }
];
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <title>Mokshagna Reddy</title>
        <link rel="icon" type="image/png" href="/favicon.png" />
        <meta
            name="description"
            content="Mokshagna Reddy — minimal portfolio."
        />
        <meta name="author" content="Mokshagna Reddy" />
        <meta name="theme-color" content="#000000" />
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link
            href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;700&display=swap"
            rel="stylesheet"
        />
        <style>
            .font-mono-stack {
                font-family:
                    "Berkeley Mono", "IBM Plex Mono", ui-monospace,
                    SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono",
                    "Courier New", monospace;
            }
        </style>
    </head>
    <body
        class="relative flex min-h-[100dvh] w-full flex-col bg-background text-foreground font-mono-stack antialiased selection:bg-white/20"
    >
        <main
            class="relative z-10 w-full max-w-4xl mx-auto px-6 py-12 md:py-20 flex flex-1 flex-col"
        >
            <header class="mb-10 md:mb-16">
                <BlurFade delay={BLUR_FADE_DELAY} client:load>
                    <div class="mb-6">
                        <OpencodeName />
                    </div>
                </BlurFade>

                <BlurFade delay={BLUR_FADE_DELAY * 2} client:load>
                    <p
                        class="text-muted-foreground text-sm leading-relaxed max-w-xl opacity-80"
                    >
                        frontend dev & cli/tui builder.
                    </p>
                </BlurFade>
            </header>

            <section class="mb-4 md:mb-8 pt-2">
                <BlurFade delay={BLUR_FADE_DELAY * 3} client:load>
                    <div class="mb-6">
                        <h2
                            class="text-xs font-medium text-foreground opacity-90"
                        >
                            Projects
                        </h2>
                    </div>
                </BlurFade>

                <div class="flex flex-col gap-2">
                    {
                        repos.map((repo, i) => (
                            <div class={i >= 4 ? "hidden extra-project" : ""}>
                                <BlurFade
                                    delay={BLUR_FADE_DELAY * 4 + i * 0.1}
                                    client:load
                                >
                                    <div class="group flex items-baseline gap-3 -mx-4 py-2 px-4 rounded-md hover:bg-white/[0.04] transition-colors">
                                        <span class="text-muted-foreground/40 shrink-0">
                                            [*]
                                        </span>
                                        <a
                                            href={repo.html_url}
                                            target="_blank"
                                            rel="noopener noreferrer"
                                            class="flex flex-col sm:flex-row sm:items-baseline justify-between w-full gap-y-1 sm:gap-x-3 min-w-0"
                                        >
                                            <strong class="font-medium text-foreground/90 group-hover:text-white transition-colors shrink-0">
                                                {repo.name}
                                            </strong>
                                            <span class="text-muted-foreground/70 text-sm sm:text-base sm:text-right">
                                                {repo.description || ""}
                                            </span>
                                        </a>
                                    </div>
                                </BlurFade>
                            </div>
                        ))
                    }
                </div>
                {repos.length > 4 && (
                    <BlurFade delay={BLUR_FADE_DELAY * 4 + 0.4} client:load>
                        <button id="show-more-projects" class="text-muted-foreground/70 hover:text-foreground text-[15px] mt-2 transition-colors">
                            + show more
                        </button>
                    </BlurFade>
                )}
            </section>

            <BlurFade delay={BLUR_FADE_DELAY * 5} client:load className="mt-auto pb-6">
                <footer
                    class="flex flex-col sm:flex-row justify-between items-center sm:items-start text-xs border-t border-white/10 pt-8 opacity-80 gap-6 sm:gap-0"
                >
                    <div class="flex gap-6 text-muted-foreground">
                        <a
                            href={github}
                            target="_blank"
                            rel="me noopener noreferrer"
                            class="hover:text-foreground transition-colors"
                            >github</a
                        >
                        <a
                            href={email}
                            class="hover:text-foreground transition-colors"
                            >email</a
                        >
                    </div>
                    <button
                        id="theme-toggle"
                        class="text-muted-foreground hover:text-foreground transition-colors"
                    >
                        <span id="theme-name">midnight</span>
                    </button>
                </footer>
            </BlurFade>
        </main>

        <script>
            const themes = ["midnight", "graphite"];
            let currentThemeIndex = 0;

            const themeToggle = document.getElementById("theme-toggle");
            const themeName = document.getElementById("theme-name");

            if (themeToggle && themeName) {
                themeToggle.addEventListener("click", () => {
                    currentThemeIndex = (currentThemeIndex + 1) % themes.length;
                    const newTheme = themes[currentThemeIndex];
                    document.documentElement.dataset.theme = newTheme;
                    themeName.innerText = newTheme;
                });
            }

            const showMoreBtn = document.getElementById("show-more-projects");
            if (showMoreBtn) {
                let isExpanded = false;
                showMoreBtn.addEventListener("click", () => {
                    isExpanded = !isExpanded;
                    document.querySelectorAll(".extra-project").forEach(el => {
                        if (isExpanded) {
                            el.classList.remove("hidden");
                        } else {
                            el.classList.add("hidden");
                        }
                    });
                    showMoreBtn.innerText = isExpanded ? "- show less" : "+ show more";
                });
            }
        </script>
    </body>
</html>
